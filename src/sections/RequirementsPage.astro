---
import Icon from '../components/Icon.astro';
import PageHero from '../components/PageHero.astro';
import CountryRequirements from '../components/CountryRequirements.astro';
import CtaBand from '../components/CtaBand.astro';
import { countriesNeedingReview } from '../data/countries';
import { getDictionary, localizedPath, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);

const pendingCount = countriesNeedingReview().length;
---

<PageHero
  locale={locale}
  page="requirements"
  title={t.requirements.h1}
  lead={t.requirements.lead}
/>

<section class="section">
  <div class="container">
    {/*
      Offenlegung des Prüfstands: Solange Länder ungeprüft sind, wird das
      sichtbar benannt, statt Verbindlichkeit zu suggerieren.
    */}
    {
      pendingCount > 0 && (
        <p class="notice mt-0" style="display:flex; gap:.75rem; align-items:flex-start;">
          <Icon name="balance" size={18} />
          <span>{t.requirements.individualNotice}</span>
        </p>
      )
    }

    <div class="mt-2xl">
      <CountryRequirements locale={locale} expanded />
    </div>

    <div class="btn-group mt-2xl">
      <a class="btn btn-accent btn-lg" href={localizedPath(locale, 'apply')}>
        <Icon name="users" size={18} />
        {t.ui.applyCta}
      </a>
      <a class="btn btn-secondary" href={localizedPath(locale, 'careers')}>
        {t.nav.careers}
      </a>
    </div>
  </div>
</section>

<CtaBand
  locale={locale}
  title={t.careers.ctaTitle}
  text={t.careers.ctaText}
  button={t.ui.applyCta}
  target="apply"
/>
