---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { SITE } from '../consts';
import {
  HEADER_NAV,
  PAGE_IDS,
  getDictionary,
  localizedPath,
  type Locale,
  type PageId,
} from '../i18n';

interface Props {
  locale: Locale;
  page: PageId;
}

const { locale, page } = Astro.props;
const t = getDictionary(locale);

const navItems = HEADER_NAV.map((id) => ({
  id,
  label: t.nav[id],
  href: localizedPath(locale, id),
  isCurrent: id === page,
}));

/**
 * Das mobile Menü führt jede Seite der Website auf – auch die, die im Kopf
 * aus Platzgründen fehlen („Einsatzgebiete“ und „Über uns“).
 *
 * Bewusst aus PAGE_IDS abgeleitet und nicht aufgezählt: Eine handgepflegte
 * Liste hatte genau diese zwei Seiten vergessen, und im Kompaktmodus ist das
 * Menü der einzige Zugang zur Navigation. So kann keine Seite mehr fehlen,
 * wenn später eine hinzukommt.
 *
 * Ausgenommen ist allein die Bewerbungsseite: Sie steht direkt darunter als
 * hervorgehobener Handlungsaufruf.
 */
const mobileItems: PageId[] = PAGE_IDS.filter((id) => id !== 'apply');
---

<a class="skip-link" href="#main">{t.ui.skipToContent}</a>

<header class="site-header" data-header>
  <div class="container header-inner" data-header-inner>
    <a class="logo" href={localizedPath(locale, 'home')}>
      <Logo class="logo-mark" />
      <span class="logo-text">
        <span class="logo-name">{SITE.name}</span>
        <span class="logo-sub">{t.ui.logoSubtitle}</span>
      </span>
    </a>

    <nav class="primary-nav" aria-label={t.nav.home}>
      <ul>
        {
          navItems.map((item) => (
            <li>
              <a href={item.href} aria-current={item.isCurrent ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header-actions">
      {/* Auf Mobilgeräten ausgeblendet – die Sprachwahl steht dort im Menü. */}
      <div class="header-lang">
        <LanguageSwitcher locale={locale} page={page} />
      </div>

      {/*
        Im Kopf steht die gekürzte Beschriftung – die vollständige Fassung
        bleibt im mobilen Menü, auf den Seiten-CTAs und hier als title.
      */}
      <a
        class="btn btn-primary header-cta header-cta-apply"
        href={localizedPath(locale, 'apply')}
        title={t.ui.applyCta}
      >
        {t.ui.applyCtaShort}
      </a>

      <a class="btn btn-primary header-cta" href={localizedPath(locale, 'contact')}>
        {t.nav.contact}
      </a>

      <button
        type="button"
        class="nav-toggle"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label={t.ui.openMenu}
        data-menu-toggle
        data-label-open={t.ui.openMenu}
        data-label-close={t.ui.closeMenu}
      >
        <Icon name="menu" class="icon-menu" />
        <Icon name="close" class="icon-close" />
      </button>
    </div>
  </div>
</header>

{/*
  Kopf messen statt raten – bewusst als Inline-Skript direkt hinter dem Kopf.

  Es läuft noch während des Parsens und damit vor dem ersten Bildaufbau. Ein
  gebündeltes Modul-Skript wäre "defer" und würde erst nach dem ersten Frame
  laufen: Der Kopf erschiene kurz in der falschen Fassung und würde dann
  umspringen – genau der Layout-Shift, der vermieden werden soll.
*/}
<script is:inline>
  (() => {
    const root = document.documentElement;
    const header = document.querySelector('[data-header]');
    const inner = header && header.querySelector('[data-header-inner]');
    if (!inner) return;

    const COMPACT = 'is-nav-compact';
    /* Reserve, damit der letzte Button nie auf Kante steht. */
    const BUFFER = 10;

    /**
     * Passen Logo, Navigation und Aktionsbereich nebeneinander?
     * Gemessen werden die natürlichen Breiten – alle Kinder stehen auf
     * flex-shrink: 0, ihre Rechtecke entsprechen daher dem Platzbedarf.
     * Ausgeblendete Kinder (der Hamburger-Schalter) liefern kein Rechteck
     * und fallen automatisch aus der Rechnung.
     */
    const fits = () => {
      const styles = getComputedStyle(inner);
      const gap = parseFloat(styles.columnGap) || 0;
      const padding =
        (parseFloat(styles.paddingLeft) || 0) + (parseFloat(styles.paddingRight) || 0);

      let needed = 0;
      let visible = 0;
      for (const child of inner.children) {
        if (child.getClientRects().length === 0) continue;
        needed += child.getBoundingClientRect().width;
        visible += 1;
      }
      needed += gap * Math.max(0, visible - 1);

      return needed <= inner.clientWidth - padding - BUFFER;
    };

    /*
      Gemessen wird immer im vollen Zustand. Die Entscheidung hängt damit
      allein von der Fensterbreite ab und nicht vom vorherigen Zustand –
      dadurch kann der Kopf nicht zwischen beiden Fassungen pendeln.
    */
    const evaluate = () => {
      const wasCompact = root.classList.contains(COMPACT);
      root.classList.remove(COMPACT);
      const compact = !fits();
      if (compact) root.classList.add(COMPACT);

      /* Verlässt der Kopf den Kompaktmodus, darf kein Menü offen bleiben. */
      if (wasCompact && !compact) {
        document.dispatchEvent(new CustomEvent('ta:nav-expanded'));
      }
    };

    /* Ab jetzt entscheidet die Messung; die Media-Query-Rückfallebene ruht. */
    root.classList.add('js-nav');
    evaluate();

    /*
      Auf Breitenänderungen reagieren. Ein ResizeObserver auf dem Kopf reicht:
      Das Umschalten verändert die Breite dieses Kastens nicht, deshalb kann
      die Rückmeldung sich nicht selbst erneut auslösen.
    */
    if (typeof ResizeObserver === 'function') {
      new ResizeObserver(evaluate).observe(inner);
    } else {
      window.addEventListener('resize', evaluate, { passive: true });
    }

    /* Nach dem Schriftwechsel sind die Textbreiten endgültig – erneut messen. */
    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(evaluate).catch(() => {});
    }
  })();
</script>

{/*
  Off-Canvas-Menü, bewusst außerhalb des Headers: Als position:fixed-Ebene
  kann es die volle Höhe einnehmen, ohne vom sticky Kopf beschnitten zu werden.
*/}
<div class="mobile-menu" id="mobile-menu" hidden data-menu>
  <div class="mobile-menu-backdrop" data-menu-backdrop></div>

  <div class="mobile-menu-panel" role="dialog" aria-modal="true" aria-label={t.nav.home}>
    <div class="mobile-menu-head">
      <span class="mobile-menu-title">
        <Logo class="mobile-menu-logo" />
        <span>{SITE.name}</span>
      </span>
      <button type="button" class="nav-toggle" aria-label={t.ui.closeMenu} data-menu-close>
        <Icon name="close" />
      </button>
    </div>

    {/*
      Sprachwahl direkt unter dem Logo und vor dem ersten Menüpunkt.

      Bewusst derselbe Baustein wie im Kopf: gleiche Bedienung, gleiche
      Tastatursteuerung, und jeder Eintrag zeigt auf dieselbe Unterseite in der
      Zielsprache – der Wechsel springt also nicht auf die Startseite zurück.

      Die eigene Kennung ist nötig, weil der Umschalter damit zweimal im
      Dokument steht. Die aufklappende Liste läuft hier im Textfluss statt
      absolut positioniert; im scrollenden Panel würde sie sonst abgeschnitten.
    */}
    <div class="mobile-menu-lang">
      <LanguageSwitcher locale={locale} page={page} menuId="mobile-language-menu" />
    </div>

    <nav class="mobile-menu-nav" aria-label={t.nav.home}>
      <ul>
        {
          mobileItems.map((id) => (
            <li>
              <a href={localizedPath(locale, id)} aria-current={id === page ? 'page' : undefined}>
                {t.nav[id]}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="mobile-menu-cta">
      <a class="btn btn-primary btn-block" href={localizedPath(locale, 'apply')}>
        {t.ui.applyCta}
      </a>
      <a class="btn btn-secondary btn-block" href={localizedPath(locale, 'contact')}>
        {t.nav.contact}
      </a>
    </div>

  </div>
</div>

<script>
  /*
    Off-Canvas-Menü.

    Geschlossen wird ausschließlich durch: Schalter, Schließen-Knopf,
    Klick auf den abgedunkelten Hintergrund, Escape oder Auswahl eines
    Menüpunkts. Scrollen, Resize, Fokuswechsel innerhalb des Menüs und
    Layout-Shifts lassen es bewusst offen.
  */
  (() => {
    const menu = document.querySelector<HTMLElement>('[data-menu]');
    const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    if (!menu || !toggle) return;
    if (menu.dataset.menuReady === 'true') return;
    menu.dataset.menuReady = 'true';

    const panel = menu.querySelector<HTMLElement>('.mobile-menu-panel');
    const backdrop = menu.querySelector<HTMLElement>('[data-menu-backdrop]');
    const closeButton = menu.querySelector<HTMLButtonElement>('[data-menu-close]');
    if (!panel) return;

    const FOCUSABLE = 'a[href], button:not([disabled])';
    let scrollY = 0;

    const isOpen = () => !menu.hidden;

    /**
     * Sperrt den Hintergrund über position: fixed statt overflow: hidden.
     * Nur so bleibt die Scrollposition erhalten – overflow: hidden springt
     * auf mobilen Browsern an den Seitenanfang zurück.
     *
     * Die Breite wird ausdrücklich in Pixel festgeschrieben: position: fixed
     * bezieht sich auf den Initial Containing Block, und der zieht die Breite
     * der vertikalen Scrollleiste nicht ab. Ohne diese Festlegung würde der
     * Seiteninhalt beim Öffnen des Menüs um rund 15 px zur Seite rutschen.
     */
    const lockBackground = () => {
      scrollY = window.scrollY;
      document.body.style.width = `${document.documentElement.clientWidth}px`;
      document.body.style.top = `-${scrollY}px`;
      document.body.classList.add('is-scroll-locked');
    };

    const unlockBackground = () => {
      document.body.classList.remove('is-scroll-locked');
      document.body.style.width = '';
      document.body.style.top = '';
      window.scrollTo({ top: scrollY, behavior: 'instant' as ScrollBehavior });
    };

    const open = () => {
      if (isOpen()) return;
      // Ein offenes Sprach-Dropdown im Kopf würde sonst darunter liegen bleiben.
      document
        .querySelectorAll<HTMLElement>('[data-lang-menu]')
        .forEach((list) => {
          list.hidden = true;
          list.closest('[data-lang-switcher]')
            ?.querySelector('[data-lang-toggle]')
            ?.setAttribute('aria-expanded', 'false');
        });

      lockBackground();
      menu.hidden = false;
      // Erzwingt einen Frame, damit der Einfahr-Übergang greift.
      requestAnimationFrame(() => menu.classList.add('is-open'));
      toggle.setAttribute('aria-expanded', 'true');
      const label = toggle.dataset.labelClose;
      if (label) toggle.setAttribute('aria-label', label);
      panel.querySelector<HTMLElement>(FOCUSABLE)?.focus();
    };

    const close = (returnFocus = true) => {
      if (!isOpen()) return;
      menu.classList.remove('is-open');
      menu.hidden = true;
      unlockBackground();
      toggle.setAttribute('aria-expanded', 'false');
      const label = toggle.dataset.labelOpen;
      if (label) toggle.setAttribute('aria-label', label);
      if (returnFocus) toggle.focus();
    };

    toggle.addEventListener('click', () => (isOpen() ? close() : open()));
    closeButton?.addEventListener('click', () => close());
    backdrop?.addEventListener('click', () => close());

    // Auswahl eines Menüpunkts schließt das Menü; die Navigation läuft weiter.
    panel.addEventListener('click', (event) => {
      const link = (event.target as HTMLElement).closest('a[href]');
      if (link) close(false);
    });

    document.addEventListener('keydown', (event) => {
      if (!isOpen()) return;

      if (event.key === 'Escape') {
        event.preventDefault();
        close();
        return;
      }

      // Fokus im Menü halten, solange es geöffnet ist.
      if (event.key === 'Tab') {
        const items = Array.from(panel.querySelectorAll<HTMLElement>(FOCUSABLE)).filter(
          (node) => node.offsetParent !== null,
        );
        if (items.length === 0) return;
        const first = items[0]!;
        const last = items[items.length - 1]!;

        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      }
    });

    /*
      Verlässt der Kopf den Kompaktmodus, muss das Menü schließen – sonst
      bliebe ein gesperrter Hintergrund ohne sichtbaren Schalter zurück.
      Das Ereignis stammt aus dem Messskript im Kopf; damit gibt es genau
      eine Quelle für den Umschaltzeitpunkt statt einer zweiten Media Query.
    */
    document.addEventListener('ta:nav-expanded', () => close(false));
  })();
</script>
