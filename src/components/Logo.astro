---
/**
 * Wortmarke: stilisiertes Sprechblasen-Paar als Sinnbild für Verdolmetschung.
 * Reines SVG, damit das Logo in jeder Größe und in beiden Farbschemata sitzt.
 */
interface Props {
  class?: string;
  variant?: 'default' | 'light';
}

const { class: className, variant = 'default' } = Astro.props;

const outer = variant === 'light' ? '#efc87a' : '#14395c';
const inner = variant === 'light' ? '#ffffff' : '#c98f22';
---

<svg
  class={className}
  viewBox="0 0 40 40"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  focusable="false"
>
  <rect width="40" height="40" rx="10" fill={outer} />
  <path
    d="M9 14.5A3.5 3.5 0 0 1 12.5 11h9a3.5 3.5 0 0 1 3.5 3.5v5a3.5 3.5 0 0 1-3.5 3.5h-5.6L11 26.8V23h-.5A1.5 1.5 0 0 1 9 21.5Z"
    fill="#ffffff"
    fill-opacity={variant === 'light' ? '0.22' : '0.95'}
  />
  <path
    d="M19 20.5a3.5 3.5 0 0 1 3.5-3.5H28a3.5 3.5 0 0 1 3.5 3.5v4A3.5 3.5 0 0 1 28 28h-.7v3.4L23.5 28h-1a3.5 3.5 0 0 1-3.5-3.5Z"
    fill={inner}
  />
</svg>
