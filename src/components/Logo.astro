---
/**
 * Bildmarke aus der Vorlage in public/branding/.
 *
 * Freigestellt aus translation-admy-logo-reference.png. Der Hintergrund ist
 * dort keine Transparenz, sondern eine fotografierte Wand – lösbar war das nur
 * über eine Maske aus drei gemessenen Kreisen: Goldring (Mitte 632/404,
 * Radius 285), vordere Sprechblase (790/450, 132) und hintere Goldblase
 * (881/561, 112). Ein Farbschlüssel schied aus, weil die Wand von rgb(19,27,34)
 * bis rgb(90,91,93) verläuft und die dunklen Stellen des Logos im selben
 * Bereich liegen.
 *
 * Globus, Sprechblasen und Farben bleiben unverändert – es wurde ausschließlich
 * freigestellt und verkleinert. Der Schriftzug steht daneben als Text; im
 * Kopfzeilenmaßstab wäre er als Bild unlesbar.
 *
 * WebP mit PNG-Rückfallebene: Als Foto komprimiert die Vorlage in PNG deutlich
 * schlechter.
 */
interface Props {
  class?: string;
  variant?: 'default' | 'light';
}

const { class: className } = Astro.props;
---

<picture class={className}>
  <source
    srcset="/branding/translation-admy-emblem.webp 280w, /branding/translation-admy-emblem@2x.webp 560w"
    sizes="44px"
    type="image/webp"
  />
  <img
    src="/branding/translation-admy-emblem.png"
    width="280"
    height="247"
    alt=""
    aria-hidden="true"
    decoding="async"
    loading="eager"
  />
</picture>
