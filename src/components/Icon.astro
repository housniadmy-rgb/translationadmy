---
import { ICON_PATHS, type IconName } from './icons';

interface Props {
  name: IconName;
  size?: number | string;
  class?: string;
  /** Nur setzen, wenn das Icon allein eine Bedeutung trägt (sonst dekorativ). */
  title?: string;
}

const { name, size = 24, class: className, title } = Astro.props;
const isDecorative = !title;

/**
 * Symbole, deren Richtung eine Bedeutung trägt und die in der arabischen
 * Fassung gespiegelt werden müssen.
 *
 * Bewusst nur diese zwei: der Weiter-Pfeil (zeigt auf das Ziel) und das
 * Migrationssymbol (Pfeil über dem Globus, zeigt die Bewegungsrichtung). Alle
 * anderen Symbole – Telefon, Waage, Uhr, Schloss, Gebäude, Kamera – haben
 * keine Leserichtung; ihr Spiegelbild wäre bedeutungslos oder irritierend.
 *
 * Gespiegelt wird in global.css über html[dir='rtl'] .icon-directional.
 */
const DIRECTIONAL: IconName[] = ['arrow-right', 'migration'];

const classes = [className, DIRECTIONAL.includes(name) ? 'icon-directional' : null]
  .filter(Boolean)
  .join(' ');
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={classes || undefined}
  aria-hidden={isDecorative ? 'true' : undefined}
  role={isDecorative ? undefined : 'img'}
  focusable="false"
>
  {title && <title>{title}</title>}
  <Fragment set:html={ICON_PATHS[name]} />
</svg>
