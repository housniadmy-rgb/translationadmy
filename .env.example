# Vorlage für die Betriebskonfiguration.
# Kopieren nach ".env" und ausfüllen. Die .env steht in .gitignore und darf
# niemals ins Repository gelangen – hier stehen ausschließlich Platzhalter.

# ---------------------------------------------------------------------------
# SMTP – Versand von Bewerbungen und Kontaktanfragen
# ---------------------------------------------------------------------------
# Beide Formulare versenden ausschließlich über eine TLS-gesicherte
# Verbindung. Ohne diese Angaben nehmen sie zwar Eingaben entgegen, melden
# aber offen einen Fehler, statt einen erfolgreichen Versand vorzutäuschen.

SMTP_HOST=smtp.example.de
SMTP_USER=name@example.de
SMTP_PASSWORD=

# Absenderadresse der Benachrichtigungen. Ohne Angabe wird SMTP_USER genutzt.
# Viele Anbieter verlangen, dass sie mit SMTP_USER übereinstimmt.
MAIL_FROM=name@example.de

# Port und Verschlüsselungsverfahren:
#   587 – STARTTLS (Standard). Die Verbindung wird nach dem Handshake auf TLS
#         hochgestuft. Bietet der Server kein STARTTLS an, bricht der Versand
#         ab – die Mail geht lieber gar nicht raus als im Klartext.
#   465 – SMTPS. Die Verbindung ist von Beginn an verschlüsselt.
SMTP_PORT=587

# Optional. Ohne Angabe wird automatisch gewählt: true bei Port 465, sonst false.
# SMTP_SECURE=false

# NUR für Testumgebungen mit selbstsigniertem Zertifikat.
# In Produktion niemals setzen: Die Verbindung wäre zwar verschlüsselt, aber
# nicht gegen einen Man-in-the-Middle geschützt.
# SMTP_ALLOW_SELF_SIGNED=false

# Konfiguration prüfen:
#   npm run smtp:check              Verbindung, TLS und Anmeldung testen
#   npm run smtp:test               zusätzlich eine Testmail versenden
#   node scripts/check-smtp.mjs --send you@example.de   an andere Adresse

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
HOST=0.0.0.0
PORT=4321
