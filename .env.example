# Konfiguration für den Betrieb – Datei kopieren nach ".env" und ausfüllen.
# .env ist in .gitignore und darf nicht ins Repository gelangen.

# ---------------------------------------------------------------------------
# E-Mail-Versand für das Bewerbungsformular (erforderlich)
# ---------------------------------------------------------------------------
# Ohne diese Angaben nimmt die Website Bewerbungen entgegen, meldet aber
# ehrlich zurück, dass der Versand noch nicht eingerichtet ist – es geht
# also keine Bewerbung stillschweigend verloren.

SMTP_HOST=smtp.example.de
SMTP_PORT=587
SMTP_USER=name@example.de
SMTP_PASSWORD=
# true bei Port 465 (implizites TLS), sonst false (STARTTLS über Port 587).
SMTP_SECURE=false
# Absenderadresse der Benachrichtigungen. Ohne Angabe wird SMTP_USER genutzt.
MAIL_FROM=name@example.de

# ---------------------------------------------------------------------------
# Kontaktformular (optional)
# ---------------------------------------------------------------------------
# Endpunkt eines Formulardienstes (z. B. Formspree). Ist nichts gesetzt,
# öffnet das Kontaktformular einen vorbereiteten E-Mail-Entwurf.
# PUBLIC_CONTACT_ENDPOINT=https://formspree.io/f/xxxxxxxx

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
HOST=0.0.0.0
PORT=4321
